{"code":"/**\n * Imports variables into the specified collection.\n * @param variables The parsed JSON data containing the variables.\n * @param collectionName The name of the collection where variables should be imported.\n */\nexport function importVariables(variables, collectionName) {\n    console.log(\"importVariables called with:\", variables, collectionName);\n    // 1) Check if the user provided a collection name\n    if (!collectionName) {\n        figma.notify(\"No collection name provided.\");\n        return;\n    }\n    try {\n        // 2) Find or create the collection\n        const collections = figma.variables.getLocalVariableCollections();\n        let targetCollection = collections.find(c => c.name === collectionName);\n        if (!targetCollection) {\n            targetCollection = figma.variables.createVariableCollection(collectionName);\n            console.log(`Created new collection: ${collectionName}`);\n        }\n        // 3) Ensure the collection has at least one mode\n        if (targetCollection.modes.length === 0) {\n            try {\n                const newModeId = targetCollection.addMode(\"Default\");\n                console.log(\"Created a 'Default' mode with ID:\", newModeId);\n            }\n            catch (error) {\n                console.error(\"Error adding mode:\", error);\n                figma.notify(\"Failed to add default mode.\");\n                return;\n            }\n        }\n        // Pick the first mode as the default mode\n        const defaultModeId = targetCollection.modes[0].modeId;\n        // 4) Process and create variables\n        if (Array.isArray(variables)) {\n            for (const v of variables) {\n                if (!v.name || !v.type) {\n                    console.warn(\"Skipping invalid variable definition:\", v);\n                    continue;\n                }\n                try {\n                    const newVar = figma.variables.createVariable(v.name, targetCollection.id, v.type);\n                    newVar.setValueForMode(defaultModeId, v.value);\n                    console.log(`Variable '${v.name}' created successfully.`);\n                }\n                catch (error) {\n                    console.error(`Error creating variable '${v.name}':`, error);\n                }\n            }\n            figma.notify(\"Variables imported successfully.\");\n        }\n        else {\n            figma.notify(\"Invalid JSON format: Expected an array of variables.\");\n        }\n    }\n    catch (error) {\n        console.error(\"Error in importVariables:\", error);\n        figma.notify(\"An error occurred during the import process.\");\n    }\n}\n","references":[]}
